digraph G {
  rankdir=LR;
  graph [fontname="DejaVu Sans", nodesep=0.7, ranksep=0.9, pad=0.3, dpi=200];
  node  [fontname="DejaVu Sans", fontsize=15, shape=ellipse, style=filled, fillcolor="#EAF1FB", color="#1F3A5F", penwidth=1.6, width=2.6, height=1.15, fixedsize=true];
  edge  [fontname="DejaVu Sans", fontsize=15, color="#1F3A5F", fontcolor="#1F3A5F", penwidth=1.3];

  start [shape=point, width=0.15, fillcolor="#1F3A5F"];
  OCIOSA          [label="S0\nOCIOSA", peripheries=2];
  COM_CREDITO     [label="S1\nCOM_CREDITO"];
  ENTREGANDO      [label="S2\nENTREGANDO"];
  FORA            [label="S3\nFORA_DE_SERVICO", fillcolor="#FBEAEA", color="#7A1F1F"];

  start -> OCIOSA;
  OCIOSA      -> COM_CREDITO [label="T1: MOEDA"];
  COM_CREDITO -> COM_CREDITO [label="T3: MOEDA"];
  COM_CREDITO -> ENTREGANDO  [label="T4: SELECIONAR"];
  COM_CREDITO -> OCIOSA      [label="T5: CANCELAR"];
  ENTREGANDO  -> OCIOSA      [label="T7: RETIRAR"];
  OCIOSA      -> FORA        [label="T2: FALHA", color="#7A1F1F", fontcolor="#7A1F1F"];
  COM_CREDITO -> FORA        [label="T6: FALHA", color="#7A1F1F", fontcolor="#7A1F1F"];
  ENTREGANDO  -> FORA        [label="T8: FALHA", color="#7A1F1F", fontcolor="#7A1F1F"];
  FORA        -> OCIOSA      [label="T9: REPARO", color="#2F6B3A", fontcolor="#2F6B3A"];
}
